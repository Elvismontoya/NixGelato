# ─────────────────────────────────────────────────────────────
# Frontend (Vite) — copiar a .env
# ─────────────────────────────────────────────────────────────
# URL base del backend (Express). En desarrollo local puede
# dejarse vacío: Vite hace proxy de /api -> http://localhost:4000
# (ver vite.config.js). En producción, la URL pública del API.
VITE_API_URL=

# ─────────────────────────────────────────────────────────────
# El backend tiene su propio archivo de entorno.
# Ver: server/.env.example  ->  copiar a server/.env
# ─────────────────────────────────────────────────────────────
